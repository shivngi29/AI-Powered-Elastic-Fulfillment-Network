# Node/React dependencies, generated builds, and local caches
node_modules/
dist/
build/
.vite/
.npm/
.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local environment values; keep sanitized example files trackable
.env
.env.*
!.env.example
!.env.*.example

# Local IDE state (shared VS Code configuration remains trackable)
.vscode/*.local.json
.vscode/.ropeproject/
.idea/workspace.xml
.idea/tasks.xml
.idea/shelf/
*.suo
*.user

# Windows and macOS generated files
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
._*

# Re-downloadable M5 source CSVs only; keep synthetic data and docs
/data/raw/M5/calendar.csv
/data/raw/M5/sales_train_evaluation.csv
/data/raw/M5/sales_train_validation.csv
/data/raw/M5/sample_submission.csv
