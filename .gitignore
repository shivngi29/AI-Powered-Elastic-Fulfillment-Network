# Python virtual environments
.venv/
.venv312/
venv/

# Python bytecode, notebook checkpoints, and tool caches
__pycache__/
*.pyc
*.pyo
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
